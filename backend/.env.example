# SocialPilot Environment Variables

PROJECT_NAME=SocialPilot
API_V1_STR=/api/v1

# Security Keys
SECRET_KEY=SUPER_SECRET_KEY_REPLACE_IN_PRODUCTION
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCRYPTION_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL=sqlite:///./socialpilot.db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OAuth Redirect Base URLs
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# LinkedIn REST API version
LINKEDIN_API_VERSION=202601

# ============================================================
# FACEBOOK
# ============================================================

# Meta App ID
FACEBOOK_CLIENT_ID=your_facebook_app_id

# Meta App Secret
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Facebook Login for Business Configuration ID
META_FACEBOOK_LOGIN_CONFIG_ID=your_facebook_login_configuration_id

# Facebook OAuth callback
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/facebook


# ============================================================
# INSTAGRAM
# ============================================================

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# Instagram OAuth callback
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/instagram


# ============================================================
# LINKEDIN
# ============================================================

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# LinkedIn OAuth callback
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/linkedin


# ============================================================
# X / TWITTER
# ============================================================

X_CLIENT_ID=your_x_twitter_client_id
X_CLIENT_SECRET=your_x_twitter_client_secret


# ============================================================
# GOOGLE / YOUTUBE
# ============================================================

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# YouTube OAuth callback
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/youtube